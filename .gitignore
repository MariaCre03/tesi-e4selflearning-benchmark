# Whitelist benchmark and ablation outputs (reports, CSV and JSON metrics only)
!risultati_benchmark/
!risultati_benchmark/**/
!risultati_benchmark/**/*.json
!risultati_benchmark/**/*.txt
!risultati_benchmark/**/*.csv
!risultati_ablation/
!risultati_ablation/*.json
!risultati_ablation/*.txt
!*.md

# Explicitly block any weights or checkpoints inside results
risultati_ablation/checkpoints/
risultati_benchmark/**/checkpoints/
*.pt
*.pth
*.ckpt


